# Recommended (no CORS): leave NEXT_PUBLIC_API_URL empty so the browser calls
# same-origin /api/v1, which Next rewrites to the API. Set the upstream server-side:
# API_UPSTREAM=https://fluffy-octo-computing-machine-byij.vercel.app
# For local dev the rewrite falls back to http://localhost:8080.
NEXT_PUBLIC_API_URL=
API_UPSTREAM=http://localhost:8080

# Google OAuth: the callback goes through this same-origin proxy, so the API's
# GOOGLE_REDIRECT_URI must be
#   <this site's origin>/api/v1/auth/google/callback
# e.g. https://nhlanganiso-app.vercel.app/api/v1/auth/google/callback
# and must be registered verbatim in Google Cloud Console.

# Public URL of this storefront (used only for display/metadata).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Business contact details. The site hides contact rows until you set REAL values
# here (placeholders are never displayed). Leave unset only if you have no
# public contact details yet.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
