# Base URL of the Rust API (no trailing slash, no /api/v1 suffix).
# Local docker compose / cargo run:
NEXT_PUBLIC_API_URL=http://localhost:8080

# Public URL of this storefront (used only for display/metadata).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Business contact details shown in the footer and catering page.
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.co.za
NEXT_PUBLIC_CONTACT_PHONE=+27 00 000 0000
